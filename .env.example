# Salin menjadi .env lalu isi dengan kredensial proyek Supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Panel akun demo tampil default; set "false" untuk menyembunyikannya di build produksi.
VITE_SHOW_DEMO_ACCOUNTS=true

# Opsional. Kosongkan untuk build lokal/Pages standar (base otomatis),
# set "/" saat memakai custom domain di akar domain.
# VITE_BASE_PATH=/

# Opsional. Endpoint penerima laporan error (JSON). Bila kosong, error hanya
# dicatat di console browser.
# VITE_ERROR_REPORT_URL=https://contoh.example/error-report

# Catatan: kredensial WhatsApp gateway TIDAK memakai prefix VITE_ karena hanya
# dibaca Edge Function di server. Isi lewat `supabase secrets set`; lihat
# supabase/functions/README.md.
